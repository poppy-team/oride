{
  "id": "visual-regression",
  "name": "Automated Visual Regression Testing",
  "version": 2,
  "schema_version": 3,
  "purpose": "Capture deterministic visual snapshots and detect unexpected layout shifts, styling regressions, and font mutations across viewports and browsers.",
  "risk_level": "low",
  "modes": [
    "testing",
    "review",
    "audit",
    "implementation"
  ],
  "inputs": [
    "Product requirements",
    "Design tokens",
    "UI components / views",
    "Target viewport matrix"
  ],
  "outputs": [
    "Visual regression test suite",
    "Playwright VRT configuration",
    "Visual comparison artifacts (baseline, actual, diff)",
    "Visual audit report"
  ],
  "requires": [],
  "conflicts": [],
  "capabilities": [
    "filesystem.read",
    "filesystem.write",
    "process.spawn"
  ],
  "references": [
    "references/visual-testing-strategies.md"
  ],
  "templates": [
    "templates/visual-regression-report.md"
  ],
  "checks": [
    "checks/visual-regression-checklist.md"
  ],
  "scripts": [
    "scripts/verify.sh",
    "scripts/compare_screenshots.js"
  ],
  "examples": [
    "examples/playwright_vrt_config.js"
  ],
  "required_evidence": [
    "test",
    "review"
  ],
  "stop_conditions": [
    "Task acceptance criteria satisfied with evidence",
    "All snapshots match baseline within configured tolerance",
    "Token budget exhausted",
    "Blocked on external dependency"
  ],
