{
  "id": "design-tokens",
  "name": "W3C Design Tokens Architecture & Multi-Platform Compilation",
  "version": 2,
  "schema_version": 3,
  "purpose": "Design, maintain, validate, and compile cross-platform design tokens adhering to W3C DTCG 2025.10 with 3-tier hierarchy, automated WCAG 2.2 contrast checking, and multi-theme aliasing.",
  "risk_level": "medium",
  "modes": [
    "implementation",
    "design",
    "review",
    "audit"
  ],
  "inputs": [
    "DTCG design token specifications (*.json)",
    "Color palettes, typography scales, and spacing grids",
    "Theme mode definitions (Light, Dark, High-Contrast)"
  ],
  "outputs": [
    "Validated W3C DTCG token definitions",
    "Compiled CSS Custom Properties and TypeScript definitions",
    "WCAG 2.2 contrast verification matrices",
    "Design Token Audit & Contrast Reports"
  ],
  "requires": [
    "clean-code",
    "ui-implementation"
  ],
  "conflicts": [],
  "capabilities": [
    "filesystem.read",
    "filesystem.write",
    "process.spawn"
  ],
  "references": [
    "references/design-tokens-guide.md"
  ],
  "templates": [
    "templates/design-tokens-report.md"
  ],
  "checks": [
    "checks/design-tokens-checklist.md"
  ],
  "scripts": [
    "scripts/verify.sh"
  ],
  "examples": [
    "examples/design-tokens.json"
  ],
  "required_evidence": [
    "test",
    "review"
  ],
  "stop_conditions": [
    "Task acceptance criteria satisfied with evidence",
