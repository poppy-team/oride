{
  "id": "architecture-quality",
  "name": "Architecture Quality",
  "version": 2,
  "schema_version": 3,
  "purpose": "Verify dependency direction, prevent architectural cycles, eliminate god modules, and enforce boundary separation.",
  "risk_level": "medium",
  "modes": [
    "design",
    "review"
  ],
  "inputs": [
    "System architecture diagrams / ADRs",
    "Module dependency graph",
    "Contract definitions"
  ],
  "outputs": [
    "Architecture compliance report",
    "ADR update proposal"
  ],
  "requires": [],
  "conflicts": [],
  "capabilities": [
    "filesystem.read",
    "filesystem.write",
    "process.spawn"
  ],
  "references": [
    "references/clean-architecture.md"
  ],
  "templates": [
    "templates/architecture-quality-template.md"
  ],
  "checks": [
    "checks/architecture-checklist.md"
  ],
  "scripts": [
    "scripts/verify.sh",
    "scripts/detect_layer_violations.sh"
  ],
  "examples": [
    "examples/ports_and_adapters.md"
  ],
  "required_evidence": [
    "review",
    "test"
  ],
  "stop_conditions": [
    "Dependency graph is acyclic and all documented boundary rules pass",
    "No core or domain module imports transport, persistence, UI, or framework internals",
    "Token budget exhausted or a required ADR owner is unavailable"
  ],
