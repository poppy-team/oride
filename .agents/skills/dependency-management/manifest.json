{
  "id": "dependency-management",
  "name": "Dependency Management",
  "version": 2,
  "schema_version": 3,
  "purpose": "Manage dependency surface, verify provenance, pin versions, and audit transitive security advisories.",
  "risk_level": "medium",
  "modes": [
    "audit",
    "implementation"
  ],
  "inputs": [
    "Project manifest (Cargo.toml, package.json, pyproject.toml)",
    "Lockfile",
    "Security advisory databases"
  ],
  "outputs": [
    "Audited lockfile",
    "Dependency vulnerability report",
    "License compliance scorecard"
  ],
  "requires": [],
  "conflicts": [],
  "capabilities": [
    "filesystem.read",
    "filesystem.write",
    "process.spawn"
  ],
  "references": [
    "references/dependency-injection-principles.md"
  ],
  "templates": [
    "templates/dependency-management-template.md"
  ],
  "checks": [
    "checks/dependency-audit.md"
  ],
  "scripts": [
    "scripts/verify.sh",
    "scripts/detect_cycles.sh"
  ],
  "examples": [
    "examples/di_container_example.md"
  ],
  "required_evidence": [
    "security-scan",
    "build"
  ],
  "stop_conditions": [
    "No unresolved critical or high advisory, provenance, or license violation remains",
    "Lockfile is reproducible and every direct dependency has an owner and upgrade policy",
    "Token budget exhausted or registry and advisory evidence is unavailable"
  ],
  "provenance": {
