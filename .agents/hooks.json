{
  "hooks": {
    "session.end": [
      {
        "exec": "prumo doctor --json",
        "type": "command"
      }
    ],
    "session.start": [
      {
        "exec": "prumo status --json",
        "type": "command"
      }
    ],
    "tool.after_execute": [
      {
        "check": "evidence_collection",
        "type": "audit"
      }
    ],
    "tool.before_execute": [
      {
        "check": "security_boundary",
        "type": "audit"
      }
    ]
  },
  "version": "1.0"
}
