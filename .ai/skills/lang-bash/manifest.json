{
  "id": "lang-bash",
  "name": "Bash Strict Defensive Engineering",
  "version": 2,
  "schema_version": 3,
  "purpose": "Enforce Bash strict error propagation (set -euo pipefail), total parameter quoting hygiene, trap-driven resource cleanup, atomic locking, and zero-eval security discipline.",
  "risk_level": "medium",
  "modes": [
    "implementation",
    "review",
    "audit",
    "testing",
    "release"
  ],
  "inputs": [
    "Bash/Shell scripts (.sh, .bash)",
    "CI/CD pipeline workflows",
    "Active task acceptance criteria"
  ],
  "outputs": [
    "Hardened shell scripts",
    "ShellCheck and syntax check evidence",
    "Execution test logs"
  ],
  "requires": [
    "clean-code",
    "secure-coding"
  ],
  "conflicts": [],
  "capabilities": [
    "filesystem.read",
    "filesystem.write",
    "process.spawn"
  ],
  "references": [
    "references/bash-defensive.md"
  ],
  "templates": [
    "templates/bash-verification-report.md"
  ],
  "checks": [
    "checks/bash-rules.md"
  ],
  "scripts": [
    "scripts/verify.sh"
  ],
  "examples": [
    "examples/safe_runner.sh"
  ],
  "required_evidence": [
    "test",
    "lint"
  ],
  "stop_conditions": [
    "Task acceptance criteria satisfied with evidence",
    "Script syntax passes bash -n with 0 errors",
    "Zero unquoted variables or dangerous eval calls detected",
    "Token budget exhausted",
    "Blocked on external dependency"
  ],
  "provenance": {
    "origin": "framework",
