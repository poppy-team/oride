    "modified": "2026-09-23"
  },
  "select": {
    "stack_any": [
      "bash",
      "sh",
      "shell",
      "posix-sh"
    ]
  },
  "requires_any": [],
  "tools": [
    "check-escape-hatches"
  ]
}
