{
  "id": "contrast",
  "name": "Color Contrast Verification (WCAG 2.2 & APCA)",
  "version": 2,
  "schema_version": 3,
  "purpose": "Verify, audit, and mathematically validate color contrast ratios across all user interfaces, graphical components, and interactive states conforming to WCAG 2.2 Level AA/AAA and APCA.",
  "risk_level": "medium",
  "modes": [
    "audit",
    "testing",
    "review",
    "implementation"
  ],
  "inputs": [
    "UI components and stylesheets (*.css, *.tsx)",
    "Design token palettes and theme modes",
    "Active task acceptance criteria"
  ],
  "outputs": [
    "WCAG 2.2 contrast verification matrices",
    "APCA perceptual legibility scorecards",
    "Color blindness simulation audit logs",
    "Color Contrast Audit Reports"
  ],
  "requires": [
    "clean-code",
    "design-tokens"
  ],
  "conflicts": [],
  "capabilities": [
    "filesystem.read",
    "filesystem.write",
    "process.spawn"
  ],
  "references": [
    "references/contrast-guide.md"
  ],
  "templates": [
    "templates/contrast-report.md"
  ],
  "checks": [
    "checks/contrast-checklist.md"
  ],
  "scripts": [
    "scripts/verify.sh"
  ],
  "examples": [
    "examples/contrast_checker.py"
  ],
  "required_evidence": [
    "test",
    "review"
  ],
  "stop_conditions": [
    "Task acceptance criteria satisfied with evidence",
    "All text elements meet WCAG 2.2 AA contrast ratios",
    "All focus indicators and UI components meet 3:1 contrast",
    "Token budget exhausted",
    "Blocked on external dependency"
  ],
