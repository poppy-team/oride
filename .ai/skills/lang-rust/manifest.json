{
  "id": "lang-rust",
  "name": "Rust Safe-by-Default & Systems Reliability",
  "version": 2,
  "schema_version": 3,
  "purpose": "Enforce safe Rust by default (#![forbid(unsafe_code)]), zero unhandled unwrap/expect in production, miri verification of unsafe boundaries, and clippy -D warnings.",
  "risk_level": "critical",
  "modes": [
    "implementation",
    "review",
    "testing",
    "audit"
  ],
  "inputs": [
    {
      "name": "source_files",
      "type": "path[]",
      "description": "Rust source files and unit/integration tests (src/**/*.rs)",
      "required": true
    },
    {
      "name": "cargo_manifest",
      "type": "path",
      "description": "Cargo.toml and Cargo.lock files",
      "required": true
    }
  ],
  "outputs": [
    {
      "name": "hardened_code",
      "type": "diff",
      "description": "Formatted, Clippy-clean, sound Rust source code"
    },
    {
      "name": "verification_report",
      "type": "document",
      "description": "Verification report conforming to templates/rust-verification-report.md"
    }
  ],
  "requires": [
    "clean-code",
    "testing-quality"
  ],
  "conflicts": [],
  "capabilities": [
    "filesystem.read",
    "filesystem.write",
    "process.spawn"
  ],
  "references": [
    "references/rust-safety-miri.md"
  ],
  "templates": [
    "templates/rust-verification-report.md"
  ],
  "checks": [
    "checks/rust-rules.md"
  ],
  "scripts": [
    "scripts/verify.sh"
  ],
  "examples": [
    "examples/safe_rust.rs"
  ],
  "required_evidence": [
    "test",
    "build",
    "lint",
    "security-scan"
  ],
  "stop_conditions": [
    "Task acceptance criteria satisfied with evidence",
    "cargo clippy -- -D warnings passes cleanly",
    "Token budget exhausted"
  ],
  "provenance": {
    "origin": "framework",
    "license": "MIT",
    "source": "prumo",
    "version": "0.6.0",
    "checksum": "",
    "modified": "2026-09-23"
  },
  "select": {
    "stack_any": [
      "rust",
      "cargo",
      "clippy",
      "rustc"
    ]
  },
  "tools": [
    "check-escape-hatches"
  ]
}
